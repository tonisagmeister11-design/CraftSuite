+    /// When an export finishes, says so and where the file is (with "Show in folder"); when it
+    /// fails, shows the error. Without this the only sign was the status bar's progress vanishing.
+    fn watch_exports(&mut self, ctx: &egui::Context) {
+        use std::sync::atomic::Ordering;
+        type Notice = (String, Option<String>);
+        let running_id = egui::Id::new("export-notice-running");
+        let notice_id = egui::Id::new("export-notice");
+        let mut running: Vec<u64> = ctx.data_mut(|d| d.get_temp(running_id)).unwrap_or_default();
+        let mut notice: Option<Notice> = ctx.data_mut(|d| d.get_temp(notice_id));
+        for j in self.session.jobs.iter().filter(|j| j.label.starts_with("Export ")) {
+            if !j.progress.finished.load(Ordering::Relaxed) {
+                if !running.contains(&j.id) {
+                    running.push(j.id);
+                }
+                continue;
+            }
+            let Some(pos) = running.iter().position(|id| *id == j.id) else { continue };
+            let result = j.result.lock().unwrap_or_else(|e| e.into_inner()).clone();
+            match result {
+                Some(Ok(report)) => notice = Some((report.path, None)),
+                Some(Err(e)) if e.to_lowercase().contains("cancel") => {}
+                Some(Err(e)) => notice = Some((String::new(), Some(e))),
+                // Finished but the result is not stored yet: look again next frame.
+                None => continue,
+            }
+            running.remove(pos);
+        }
+        ctx.data_mut(|d| d.insert_temp(running_id, running));
+        let Some((path, error)) = notice else { return };
+        let (mut close, mut reveal) = (false, false);
+        let title = if error.is_none() { "Export abgeschlossen" } else { "Export fehlgeschlagen" };
+        egui::Window::new(title)
+            .id(egui::Id::new("export-notice-window"))
+            .collapsible(false)
+            .resizable(false)
+            .anchor(egui::Align2::CENTER_CENTER, [0.0, 0.0])
+            .show(ctx, |ui| {
+                match &error {
+                    None => {
+                        ui.label("Das Video wurde gespeichert unter:");
+                        ui.add_space(4.0);
+                        ui.monospace(&path);
+                        ui.add_space(8.0);
+                        ui.horizontal(|ui| {
+                            if ui.button("Im Ordner zeigen").clicked() {
+                                reveal = true;
+                                close = true;
+                            }
+                            if ui.button("OK").clicked() {
+                                close = true;
+                            }
+                        });
+                    }
+                    Some(e) => {
+                        ui.label(e.as_str());
+                        ui.add_space(8.0);
+                        if ui.button("OK").clicked() {
+                            close = true;
+                        }
+                    }
+                }
+            });
+        if reveal && let Err(e) = panels::menu_dialogs::open_path(self, ctx, &path, true) {
+            self.ui.status = e;
+        }
+        if close {
+            ctx.data_mut(|d| d.remove::<Notice>(notice_id));
+        } else {
+            ctx.data_mut(|d| d.insert_temp(notice_id, (path, error)));
+        }
+    }
+
